# FORMA · Variables de entorno
#
# Copia esto a `.env` y rellenalo. `.env` esta en `.gitignore`.
#
# Nada de esto tiene valor por defecto en el codigo: si falta una variable, la
# app falla de forma visible en vez de conectar contra el sitio equivocado.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# La API: `npx supabase status` la imprime como API_URL.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# La clave **publicable** (la que antes se llamaba anon). Va dentro del cliente
# a proposito: con ella, lo unico que protege los datos de otros usuarios es el
# RLS. La clave secreta nunca debe entrar en un cliente.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Credenciales de la cuenta de demostracion, para que la pantalla de acceso
# venga precargada. Son datos de desarrollo: en produccion no deberian existir.
VITE_SUPABASE_DEMO_EMAIL=
VITE_SUPABASE_DEMO_PASSWORD=

# El cliente Flutter lee las suyas de `forma/lib/data/supabase_config.dart`, con
# nombres distintos y sin prefijo. Se pasan en la linea de ordenes:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://TU-PROYECTO.supabase.co \
#     --dart-define=SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Y `scripts/check-api.sh` usa `FORMA_ANON` y `FORMA_API` para apuntar a otro
# entorno sin tocar el script.