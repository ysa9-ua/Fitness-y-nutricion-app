# Copy this file to `keystore.properties` and fill in your own values to sign
# release builds. `keystore.properties` is gitignored on purpose.
#
# Generate a key with:
#   keytool -genkeypair -v -keystore forma-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias forma
#
storeFile=keystore.properties.dummy
storePassword=
keyAlias=
keyPassword=
